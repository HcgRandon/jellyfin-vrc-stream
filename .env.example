# Jellyfin Configuration
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_api_key_here

# Cache Directory
CACHE_DIR=/tmp/hls-cache

# Access Control
# REQUIRED: without this, admin/browsing endpoints (search, recent, streams, profiles,
# thumbnails) refuse all requests and no share links can be created - playback is
# effectively disabled until this is set.
ADMIN_API_KEY=change_me_to_a_long_random_value
# External base URL used to build share links returned by POST /share.
# If unset, falls back to the request's own base URL (fine for local testing,
# but should be set to your public reverse-proxy URL in production).
PUBLIC_BASE_URL=https://stream.example.com
# Default lifetime for share links created without an explicit ttl_seconds
DEFAULT_SHARE_TTL_SECONDS=86400
